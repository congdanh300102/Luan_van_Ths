\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Debt-group distribution in Dataset A ($n = 27{,}001$). Group 1 (standard debt) alone accounts for 77.6\% of loan contracts, while the three non-performing groups (3--5) together account for only 17.6\%.}}{6}{figure.caption.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Data cleaning}{6}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Distribution of key numeric variables in Dataset A. \texttt  {BASE\_BAL} and \texttt  {CURR\_BAL} are plotted on a $\log _{10}$ scale to reveal their approximately log-normal shape; \texttt  {UTIL\_RATE} shows a visible spike at the clip boundary of 10, confirming that the clipping rule in Section 3.4 is binding for a non-trivial share of contracts; \texttt  {DAYS\_TO\_MATURITY} is markedly bimodal around zero, separating loans already past their reference-date maturity from loans with substantial remaining tenor.}}{7}{figure.caption.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Leakage control}{7}{subsection.3.3}\protected@file@percent }
